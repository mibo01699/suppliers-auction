// hybrid_payment_contract_test.rs - ملف اختبار عقد المقاصة التوافقية المرنة

#[cfg(test)]
mod test {
    use super::*;
    use soroban_sdk::{Env, Address};

    #[test]
    fn test_flexible_gcv_settlement_precision() {
        // 1. تهيئة بيئة اختبار البلوكشين الافتراضية
        let env = Env::default();
        let contract_id = env.register_contract(None, HybridPaymentContract);
        let client = HybridPaymentContractClient::new(&env, &contract_id);

        // 2. إنشاء عناوين افتراضية للمشتري والبائع
        let buyer = Address::generate(&env);
        let seller = Address::generate(&env);

        // 3. تحديد مدخلات الصفقة (مثال: إجمالي العطاء 100,000 وحدة عملة محلية صغرى)
        let total_amount: i128 = 100_000;
        let gcv_rate: i128 = 314_159; // سعر الـ GCV المقوم محلياً
        let pi_ratio_percentage: u32 = 40; // نسبة الـ Pi التوافقية المتفق عليها (40%)

        // 4. استدعاء دالة العقد الذكي وحساب المخرجات
        let (yer_share, required_pi_stroops) = client.settle_hybrid_deal(
            &buyer,
            &seller,
            &total_amount,
            &gcv_rate,
            &pi_ratio_percentage,
        );

        // 5. التحقق الصارم من صحة الحسابات ميكانيكياً (حصة YER = 60% وحصة Pi = 40%)
        let expected_yer_share = (total_amount * 60) / 100; // 60,000
        let expected_pi_share_currency = total_amount - expected_yer_share; // 40,000
        let expected_pi_stroops = (expected_pi_share_currency * 10_000_000) / gcv_rate;

        // التأكد من تطابق المخرجات الفعلية مع الحسابات الرياضية الصفرية للفواصل
        assert_eq!(yer_share, expected_yer_share);
        assert_eq!(required_pi_stroops, expected_pi_stroops);
    }
}
